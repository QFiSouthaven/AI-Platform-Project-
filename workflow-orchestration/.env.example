# Application
APP_NAME=workflow-orchestration
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8002

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workflow_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=workflow-orchestration-group
KAFKA_AUTO_OFFSET_RESET=earliest

# Kafka Topics
KAFKA_WORKFLOW_EVENTS_TOPIC=workflow.events
KAFKA_TASK_EVENTS_TOPIC=workflow.task.events
KAFKA_TASK_RESULTS_TOPIC=workflow.task.results

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Scheduler
SCHEDULER_MAX_WORKERS=10
SCHEDULER_JOB_COALESCE=true
SCHEDULER_MISFIRE_GRACE_TIME=60

# Workflow Defaults
DEFAULT_WORKFLOW_TIMEOUT=3600
DEFAULT_TASK_TIMEOUT=300
DEFAULT_RETRY_COUNT=3
DEFAULT_RETRY_DELAY=60

# External Services
CORE_PROCESSING_URL=http://localhost:8003
DATA_INTEGRATION_URL=http://localhost:8004
MODEL_MANAGEMENT_URL=http://localhost:8005
