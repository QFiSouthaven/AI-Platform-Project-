# Infrastructure Module - Environment Variables
# Copy this file to .env and update with your values
# Windows 11 compatible configuration

# Application settings
APP_NAME=infrastructure-module
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8006

# CORS settings (JSON array format)
CORS_ORIGINS=["*"]

# Ray cluster settings - Windows compatible
# On Windows, Ray runs in local mode with limited features
RAY_ADDRESS=auto
RAY_NAMESPACE=ai-platform
RAY_NUM_CPUS=4
RAY_NUM_GPUS=
RAY_OBJECT_STORE_MEMORY=
RAY_DASHBOARD_HOST=0.0.0.0
RAY_DASHBOARD_PORT=8265
# Windows path for Ray temp directory
RAY_TEMP_DIR=C:/Temp/ray
RAY_LOG_TO_DRIVER=True
# Dashboard disabled on Windows due to compatibility issues
RAY_INCLUDE_DASHBOARD=False

# Task execution settings
TASK_DEFAULT_TIMEOUT=300
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=5
TASK_QUEUE_MAX_SIZE=10000
TASK_RESULT_TTL=3600

# Worker settings
MIN_WORKERS=1
MAX_WORKERS=10
WORKERS_PER_NODE=4
WORKER_CPU_FRACTION=0.25
WORKER_MEMORY_MB=1024
WORKER_IDLE_TIMEOUT=300

# Auto-scaling settings
AUTOSCALE_ENABLED=True
AUTOSCALE_CHECK_INTERVAL=30
AUTOSCALE_COOLDOWN_PERIOD=120
AUTOSCALE_CPU_THRESHOLD_HIGH=80.0
AUTOSCALE_CPU_THRESHOLD_LOW=30.0
AUTOSCALE_MEMORY_THRESHOLD_HIGH=85.0
AUTOSCALE_MEMORY_THRESHOLD_LOW=40.0
AUTOSCALE_QUEUE_THRESHOLD=100
AUTOSCALE_SCALE_UP_INCREMENT=2
AUTOSCALE_SCALE_DOWN_INCREMENT=1

# Health monitoring settings
HEALTH_CHECK_INTERVAL=15
HEALTH_CHECK_TIMEOUT=10
HEALTH_FAILURE_THRESHOLD=3
HEALTH_RECOVERY_THRESHOLD=2

# Resource management settings
RESOURCE_RESERVATION_TIMEOUT=60
RESOURCE_CLEANUP_INTERVAL=300

# Metrics settings
METRICS_ENABLED=True
METRICS_COLLECTION_INTERVAL=10
METRICS_RETENTION_PERIOD=86400
METRICS_AGGREGATION_INTERVAL=60

# Redis settings (optional - install Redis for Windows)
# Download from: https://github.com/microsoftarchive/redis/releases
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=infrastructure:
REDIS_TTL=3600

# Kafka settings (optional - install Apache Kafka or use WSL)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=infrastructure
KAFKA_CONSUMER_GROUP=infrastructure-consumers

# Security settings
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
API_KEY_HEADER=X-API-Key

# NGINX settings (for production deployment)
NGINX_UPSTREAM_NAME=infrastructure_backend
NGINX_MAX_CONNECTIONS=1000
NGINX_KEEPALIVE=32
