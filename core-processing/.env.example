# Application
APP_NAME=core-processing
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# LLM Configuration
MODEL_NAME=bigcode/starcoder
HF_API_TOKEN=your_huggingface_token_here
USE_GPU=True
MAX_SEQUENCE_LENGTH=2048
TEMPERATURE=0.7
TOP_P=0.95
TOP_K=50
REPETITION_PENALTY=1.1
DO_SAMPLE=True
NUM_RETURN_SEQUENCES=1

# Model Loading
MODEL_CACHE_DIR=/tmp/model_cache
LOAD_IN_8BIT=False
LOAD_IN_4BIT=False
DEVICE_MAP=auto
TORCH_DTYPE=float16

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=core-processing-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=True

# Kafka Topics
KAFKA_TOPIC_GENERATION_REQUEST=processing.code.generation.request
KAFKA_TOPIC_GENERATION_RESULT=processing.code.generation.result
KAFKA_TOPIC_DEBUG_REQUEST=processing.code.debug.request
KAFKA_TOPIC_DEBUG_RESULT=processing.code.debug.result
KAFKA_TOPIC_OPTIMIZE_REQUEST=processing.code.optimize.request
KAFKA_TOPIC_OPTIMIZE_RESULT=processing.code.optimize.result
KAFKA_TOPIC_EVALUATE_REQUEST=processing.code.evaluate.request
KAFKA_TOPIC_EVALUATE_RESULT=processing.code.evaluate.result

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
API_KEY_HEADER=X-API-Key

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Timeouts
INFERENCE_TIMEOUT=120
KAFKA_TIMEOUT=30

# GPU Memory Management
MAX_GPU_MEMORY_MB=
CLEAR_CACHE_THRESHOLD=0.9
