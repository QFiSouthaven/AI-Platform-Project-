# Application
APP_NAME=model-management
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8005
WORKERS=4

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=model_management
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# Storage
MODEL_STORAGE_PATH=/data/models
PLUGIN_STORAGE_PATH=/data/plugins
TEMP_STORAGE_PATH=/tmp/model-management
MAX_MODEL_SIZE_MB=10000

# Encryption
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here
ENCRYPTION_KEY_PATH=/secrets/encryption.key
ENABLE_ENCRYPTION=True
KEY_ROTATION_DAYS=90

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
API_KEY_HEADER=X-API-Key

# Kafka (optional)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=model-management
KAFKA_CONSUMER_GROUP=model-management-group

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Model Loading
MODEL_LOAD_TIMEOUT_SECONDS=300
MAX_LOADED_MODELS=10
MODEL_CACHE_SIZE_MB=5000

# Versioning
MAX_VERSIONS_PER_MODEL=100
AUTO_CLEANUP_OLD_VERSIONS=True
KEEP_LAST_N_VERSIONS=10
