# Model Management Module - Environment Variables
# Copy this file to .env and update with your values
# Windows 11 compatible configuration

# Application
APP_NAME=model-management
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8005
WORKERS=4

# MongoDB
# For Windows, ensure MongoDB is installed and running
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=model_management
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# Storage - Windows paths (use forward slashes or escaped backslashes)
# Default paths use %LOCALAPPDATA% which is typically C:\Users\<user>\AppData\Local
# You can also use absolute paths like: C:/data/models or C:\\data\\models
MODEL_STORAGE_PATH=C:/ProgramData/model-management/models
PLUGIN_STORAGE_PATH=C:/ProgramData/model-management/plugins
TEMP_STORAGE_PATH=C:/Temp/model-management
MAX_MODEL_SIZE_MB=10000

# Encryption
# Generate a secure key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here
ENCRYPTION_KEY_PATH=C:/ProgramData/model-management/secrets/encryption.key
ENABLE_ENCRYPTION=True
KEY_ROTATION_DAYS=90

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
API_KEY_HEADER=X-API-Key

# Kafka (optional - install Apache Kafka for Windows or use WSL)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=model-management
KAFKA_CONSUMER_GROUP=model-management-group

# Redis (optional - install Redis for Windows or use WSL)
# Download from: https://github.com/microsoftarchive/redis/releases
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Model Loading
MODEL_LOAD_TIMEOUT_SECONDS=300
MAX_LOADED_MODELS=10
MODEL_CACHE_SIZE_MB=5000

# Versioning
MAX_VERSIONS_PER_MODEL=100
AUTO_CLEANUP_OLD_VERSIONS=True
KEEP_LAST_N_VERSIONS=10
