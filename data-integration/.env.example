# Data Integration Module - Environment Variables
# Windows 11 Compatible Configuration

# Application
APP_NAME=data-integration
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8004

# Redis Configuration
# Windows: Redis for Windows can be installed via WSL2 or Memurai
# Default connection string works for both Windows and Linux
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_DECODE_RESPONSES=True
REDIS_DEFAULT_TTL=3600

# Kafka Configuration
# Windows: Kafka can be run via WSL2, Docker, or native Windows installation
# Ensure Kafka and Zookeeper are running before starting this service
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=data-integration-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=True
KAFKA_AUTO_COMMIT_INTERVAL_MS=5000
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_RECORDS=500

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
API_KEY_HEADER=X-API-Key

# Event Processing
EVENT_RETRY_MAX_ATTEMPTS=3
EVENT_RETRY_DELAY_SECONDS=5
EVENT_PROCESSING_TIMEOUT=30

# Cache Settings
CACHE_KEY_PREFIX=data_integration
CACHE_DEFAULT_TTL=3600
CACHE_MAX_KEYS=10000

# Metrics
ENABLE_METRICS=True
METRICS_PORT=9090

# Windows-specific Notes:
# - Use WSL2 for running Redis and Kafka if native Windows versions are unavailable
# - Alternatively, use Docker Desktop for Windows to run these services
# - Example Docker commands:
#   docker run -d --name redis -p 6379:6379 redis:latest
#   docker run -d --name kafka -p 9092:9092 -e KAFKA_CFG_NODE_ID=1 -e KAFKA_CFG_PROCESS_ROLES=broker,controller bitnami/kafka:latest
